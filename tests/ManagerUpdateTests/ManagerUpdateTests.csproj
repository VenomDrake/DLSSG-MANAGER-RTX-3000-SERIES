<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="Fixtures/**/*.cs" />
    <ProjectReference Include="../../src/DlssgManager.Core/DlssgManager.Core.csproj" />
    <ProjectReference Include="Fixtures/Old/Old.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="Fixtures/New/New.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>
  <Target Name="CopyFixtureExecutables" AfterTargets="Build">
    <MakeDir Directories="$(OutDir)Fixtures" />
    <Copy SourceFiles="Fixtures/Old/bin/$(Configuration)/net10.0/DLSSGModManager.exe" DestinationFiles="$(OutDir)Fixtures/Old.exe" />
    <Copy SourceFiles="Fixtures/New/bin/$(Configuration)/net10.0/DLSSGModManager.exe" DestinationFiles="$(OutDir)Fixtures/New.exe" />
  </Target>
</Project>

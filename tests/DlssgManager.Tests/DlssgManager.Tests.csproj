<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><OutputType>Exe</OutputType><TargetFramework>net10.0</TargetFramework><ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable></PropertyGroup>
  <ItemGroup><ProjectReference Include="../../src/DlssgManager.Core/DlssgManager.Core.csproj" /></ItemGroup>
  <ItemGroup>
    <Compile Remove="Fixtures/**/*.cs" />
    <ProjectReference Include="Fixtures/OptiScaler/OptiScaler.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>
  <Target Name="CopyOptiScalerFixture" AfterTargets="Build">
    <Copy SourceFiles="$(MSBuildProjectDirectory)/Fixtures/OptiScaler/bin/$(Configuration)/net10.0/SyntheticOptiScaler.dll" DestinationFolder="$(OutDir)fixtures" />
  </Target>
</Project>

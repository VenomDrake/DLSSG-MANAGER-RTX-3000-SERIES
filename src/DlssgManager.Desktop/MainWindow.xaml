<Window x:Class="DlssgManager.Desktop.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="DLSSG Mod Manager" Width="1320" Height="940" MinWidth="1060" MinHeight="740" Style="{StaticResource {x:Type Window}}"
 WindowStartupLocation="CenterScreen" Loaded="Window_Loaded" Closing="Window_Closing">
 <Grid Margin="28,23,28,18">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid Margin="0,0,0,22">
   <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="190"/></Grid.ColumnDefinitions>
   <Border Width="50" Height="50" Background="#183C36" CornerRadius="12" Margin="0,0,17,0" VerticalAlignment="Top">
    <Canvas Width="34" Height="34"><Rectangle Width="22" Height="16" Stroke="#70E5BB" StrokeThickness="2.5" RadiusX="2" RadiusY="2" Canvas.Top="4" Canvas.Left="2"/><Rectangle Width="22" Height="16" Fill="#183C36" Stroke="#70E5BB" StrokeThickness="2.5" RadiusX="2" RadiusY="2" Canvas.Top="13" Canvas.Left="11"/></Canvas>
   </Border>
   <StackPanel Grid.Column="1"><TextBlock Text="DLSSG Mod Manager" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="{DynamicResource tagline}" Foreground="{StaticResource Muted}" Margin="0,5,10,0"/></StackPanel>
   <StackPanel Grid.Column="2"><TextBlock Text="{DynamicResource language}" Style="{StaticResource Caption}"/><ComboBox x:Name="LanguagePicker" SelectionChanged="Language_Changed" AutomationProperties.Name="Language"/></StackPanel>
  </Grid>
  <TabControl Grid.Row="1" x:Name="MainTabs">
   <TabItem Header="{DynamicResource workspace}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,18,10,16" Foreground="{StaticResource Text}">
     <StackPanel>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
       <Border Style="{StaticResource Card}"><StackPanel>
        <TextBlock Text="{DynamicResource release_title}" Foreground="{StaticResource Accent}" FontSize="12" FontWeight="SemiBold"/>
        <TextBlock x:Name="PackageVersion" Text="—" FontSize="29" FontWeight="SemiBold" Margin="0,8,0,4"/>
        <TextBlock x:Name="PackageStatus" Text="{DynamicResource checking_update}" Foreground="{StaticResource Muted}" MinHeight="38"/>
        <StackPanel Orientation="Horizontal" Margin="0,12,0,0"><Button x:Name="UpdateButton" Content="{DynamicResource check_update}" Click="Update_Click"/><Button Content="{DynamicResource upstream}" Click="Upstream_Click" Margin="9,0,0,0"/></StackPanel>
       </StackPanel></Border>
       <Border Grid.Column="2" Style="{StaticResource Card}"><StackPanel>
        <TextBlock Text="{DynamicResource hardware_title}" Foreground="{StaticResource Accent}" FontSize="12" FontWeight="SemiBold"/>
        <TextBlock x:Name="GpuName" Text="—" FontSize="23" FontWeight="SemiBold" Margin="0,8,0,5"/>
        <TextBlock x:Name="HardwareStatus" Text="{DynamicResource hardware_pending}" Foreground="{StaticResource Muted}" MinHeight="38"/>
        <Button x:Name="HardwareButton" Content="{DynamicResource refresh_hardware}" Click="Hardware_Click" HorizontalAlignment="Left" Margin="0,12,0,0"/>
       </StackPanel></Border>
      </Grid>
      <Border Style="{StaticResource Card}" Margin="0,16,0,16"><StackPanel>
       <TextBlock Text="{DynamicResource game_title}" Foreground="{StaticResource Accent}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,13"/>
       <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBox x:Name="FolderPath" ToolTip="{DynamicResource folder_hint}" AutomationProperties.Name="Game folder path" KeyDown="Folder_KeyDown"/>
        <Button Grid.Column="1" x:Name="FolderButton" Content="{DynamicResource choose_folder}" Click="Folder_Click" Margin="9,0,0,0"/>
        <Button Grid.Column="2" x:Name="ExeButton" Content="{DynamicResource choose_exe}" Click="Exe_Click" Margin="9,0,0,0"/>
        <Button Grid.Column="3" x:Name="AnalyzeButton" Content="{DynamicResource analyze}" Click="Analyze_Click" Style="{StaticResource Primary}" Margin="9,0,0,0"/>
       </Grid>
       <Grid Margin="0,13,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <StackPanel><TextBlock Text="{DynamicResource steam_library}" Style="{StaticResource Caption}"/><ComboBox x:Name="SteamPicker" SelectionChanged="Steam_Changed" DisplayMemberPath="Name" AutomationProperties.Name="Installed Steam games"/></StackPanel>
        <Button Grid.Column="1" x:Name="SteamButton" Content="{DynamicResource refresh_steam}" Click="SteamRefresh_Click" Margin="9,23,0,0"/>
        <StackPanel Grid.Column="3"><TextBlock Text="{DynamicResource rendering_exe}" Style="{StaticResource Caption}"/><ComboBox x:Name="ExePicker" SelectionChanged="Exe_Changed" DisplayMemberPath="Name" AutomationProperties.Name="Rendering executable"/></StackPanel>
       </Grid>
       <TextBlock x:Name="GameSummary" Text="{DynamicResource select_game_first}" Foreground="{StaticResource Muted}" Margin="0,12,0,0"/>
      </StackPanel></Border>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
       <Border Style="{StaticResource Card}" VerticalAlignment="Top"><StackPanel>
        <TextBlock Text="{DynamicResource checks_title}" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,15"/>
        <ScrollViewer MaxHeight="450" VerticalScrollBarVisibility="Auto"><ItemsControl x:Name="CheckList"><ItemsControl.ItemTemplate><DataTemplate>
         <Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="0,10"><Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="26"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <TextBlock Text="{Binding Symbol}" Foreground="{Binding Color}" FontWeight="Bold" FontSize="16"/>
          <StackPanel Grid.Column="1" Margin="0,0,12,0"><TextBlock Text="{Binding Title}" FontWeight="SemiBold"/><TextBlock Text="{Binding Detail}" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,5,0,0" TextWrapping="Wrap"/></StackPanel>
          <TextBlock Grid.Column="2" Text="{Binding Status}" Foreground="{Binding Color}" FontSize="11" MaxWidth="92"/>
         </Grid></Border>
        </DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
        <Button Content="{DynamicResource graphics_settings}" Click="Graphics_Click" Margin="0,16,0,8"/>
        <Button Content="{DynamicResource driver_page}" Click="Driver_Click"/>
       </StackPanel></Border>
       <Border Grid.Column="2" Style="{StaticResource Card}" VerticalAlignment="Top"><StackPanel>
        <TextBlock Text="{DynamicResource options_title}" FontSize="20" FontWeight="SemiBold"/>
        <TextBlock Text="{DynamicResource recommended}" Foreground="{StaticResource Accent}" FontSize="12" Margin="0,7,0,17"/>
        <Grid x:Name="OptionsGrid"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
         <StackPanel>
          <TextBlock Text="{DynamicResource engine}" Style="{StaticResource Caption}"/><ComboBox x:Name="EnginePicker" SelectionChanged="Engine_Changed" Margin="0,0,0,13"/>
          <TextBlock Text="{DynamicResource optimization}" Style="{StaticResource Caption}"/><ComboBox x:Name="OptimizationPicker" Margin="0,0,0,13"/>
          <TextBlock Text="{DynamicResource super_resolution}" Style="{StaticResource Caption}"/><ComboBox x:Name="SrPicker" Margin="0,0,0,13"/>
          <TextBlock Text="{DynamicResource flow_resolution}" Style="{StaticResource Caption}"/><ComboBox x:Name="FlowPicker" Margin="0,0,0,13"/>
          <TextBlock Text="{DynamicResource proxy}" Style="{StaticResource Caption}"/><ComboBox x:Name="ProxyPicker" ToolTip="{DynamicResource proxy_help}"/>
         </StackPanel>
         <StackPanel Grid.Column="2">
          <TextBlock Text="{DynamicResource multiplier}" Style="{StaticResource Caption}"/><ComboBox x:Name="MultiplierPicker" Margin="0,0,0,13"/>
          <TextBlock Text="{DynamicResource preset}" Style="{StaticResource Caption}"/><ComboBox x:Name="PresetPicker" Margin="0,0,0,13"/>
          <TextBlock Text="{DynamicResource log_level}" Style="{StaticResource Caption}"/><ComboBox x:Name="LogPicker" Margin="0,0,0,13"/>
          <TextBlock Text="{DynamicResource hudless}" Style="{StaticResource Caption}"/><ComboBox x:Name="HudPicker" Margin="0,0,0,13"/>
          <CheckBox x:Name="TimingCheck" Content="{DynamicResource frame_timing}"/>
         </StackPanel>
        </Grid>
        <TextBlock Text="{DynamicResource option_help}" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,17,0,8"/>
        <TextBlock Text="{DynamicResource sr_help}" Foreground="{StaticResource Muted}" FontSize="12"/>
       </StackPanel></Border>
      </Grid>
      <Border Style="{StaticResource Card}" Margin="0,16,0,0"><StackPanel>
       <TextBlock Text="{DynamicResource ready_title}" FontSize="20" FontWeight="SemiBold"/>
       <TextBlock Text="{DynamicResource ready_description}" Foreground="{StaticResource Muted}" Margin="0,7,0,16"/>
       <WrapPanel><Button x:Name="InstallButton" Content="{DynamicResource install}" Style="{StaticResource Primary}" Click="Install_Click" IsEnabled="False" Margin="0,0,9,9"/><Button x:Name="DisableButton" Content="{DynamicResource disable}" Click="Disable_Click" IsEnabled="False" Margin="0,0,9,9"/><Button x:Name="RestoreButton" Content="{DynamicResource restore}" Click="Restore_Click" IsEnabled="False" Margin="0,0,9,9"/><Button x:Name="LaunchButton" Content="{DynamicResource launch}" Click="Launch_Click" IsEnabled="False" Margin="0,0,9,9"/><Button x:Name="ReadLogButton" Content="{DynamicResource read_log}" Click="ReadLog_Click" IsEnabled="False" Margin="0,0,0,9"/></WrapPanel>
      </StackPanel></Border>
     </StackPanel>
    </ScrollViewer>
   </TabItem>
   <TabItem Header="{DynamicResource diagnostics}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,18,10,16" Foreground="{StaticResource Text}"><StackPanel>
     <Border Style="{StaticResource Card}"><StackPanel><TextBlock x:Name="VerificationStatus" Text="{DynamicResource not_verified}" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="{DynamicResource log_scope}" Foreground="{StaticResource Muted}" Margin="0,10,0,0"/><TextBlock x:Name="VerificationDetails" Margin="0,14,0,0"/><TextBlock x:Name="VerificationErrors" Foreground="#FFC479" Margin="0,10,0,0"/></StackPanel></Border>
     <Border Style="{StaticResource Card}" Margin="0,16,0,0"><StackPanel><TextBlock Text="{DynamicResource hags_help}"/><Button Content="{DynamicResource graphics_settings}" Click="Graphics_Click" HorizontalAlignment="Left" Margin="0,14,0,0"/></StackPanel></Border>
     <Border Style="{StaticResource Card}" Margin="0,16,0,0"><StackPanel><TextBlock Text="{DynamicResource report_privacy}" Foreground="{StaticResource Muted}"/><Button Content="{DynamicResource export_report}" Click="Export_Click" HorizontalAlignment="Left" Margin="0,14,0,0"/><TextBlock Text="{DynamicResource independent}" Foreground="{StaticResource Muted}" Margin="0,24,0,5"/><TextBlock Text="{DynamicResource software_version}" Foreground="{StaticResource Muted}"/></StackPanel></Border>
    </StackPanel></ScrollViewer>
   </TabItem>
  </TabControl>
  <Grid Grid.Row="2" Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel><ProgressBar x:Name="OperationBar" Height="3" Foreground="{StaticResource Accent}" Background="{StaticResource Line}" Visibility="Collapsed" Margin="0,0,14,8"/><TextBlock x:Name="StatusText" Text="{DynamicResource idle}" Foreground="{StaticResource Muted}" FontSize="12"/><TextBlock Text="{DynamicResource privacy_footer}" FontSize="11" Foreground="#73889D" Margin="0,5,0,0"/></StackPanel>
   <Button Grid.Column="1" x:Name="CancelButton" Content="{DynamicResource cancel}" Click="Cancel_Click" Visibility="Collapsed" Margin="12,0,0,0"/>
  </Grid>
 </Grid>
</Window>

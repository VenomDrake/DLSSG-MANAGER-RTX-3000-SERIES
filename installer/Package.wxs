<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs" xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package Name="DLSSG Mod Manager" Manufacturer="DLSSG Mod Manager contributors" Version="$(var.AppVersion)" Language="1033" UpgradeCode="B704AF01-12FC-43EF-AB32-A3859FB716D0" Scope="perUser">
    <MajorUpgrade DowngradeErrorMessage="A newer version of DLSSG Mod Manager is already installed." />
    <MediaTemplate EmbedCab="yes" />
    <SetProperty Id="ARPINSTALLLOCATION" Value="[APPFOLDER]" After="CostFinalize" />
    <Launch Condition="VersionNT64" Message="DLSSG Mod Manager requires 64-bit Windows 10 or Windows 11." />
    <StandardDirectory Id="LocalAppDataFolder"><Directory Id="INSTALLFOLDER" Name="Programs"><Directory Id="APPFOLDER" Name="DLSSG Mod Manager">
      <Component Id="ApplicationFiles" Guid="724019F1-7127-4CA5-B115-7F5883888870">
        <File Id="ManagerExe" Source="$(var.PublishDir)/DLSSGModManager.exe">
          <Shortcut Id="StartMenuShortcut" Directory="ApplicationProgramsFolder" Name="DLSSG Mod Manager" WorkingDirectory="APPFOLDER" Advertise="no" />
          <Shortcut Id="DesktopShortcut" Directory="DesktopFolder" Name="DLSSG Mod Manager" WorkingDirectory="APPFOLDER" Advertise="no" />
        </File>
        <File Source="$(var.PublishDir)/LICENSE" />
        <File Source="$(var.PublishDir)/THIRD_PARTY_NOTICES.md" />
        <File Source="$(var.PublishDir)/README.md" />
        <File Source="$(var.PublishDir)/DOTNET-RUNTIME-LICENSE.txt" />
        <File Source="$(var.PublishDir)/WPF-LICENSE.txt" />
        <File Source="$(var.PublishDir)/DOTNET-THIRD-PARTY-NOTICES.txt" />
        <RegistryValue Root="HKCU" Key="Software\DLSSGModManager" Name="Installed" Type="integer" Value="1" KeyPath="yes" />
        <RegistryValue Root="HKCU" Key="Software\DLSSGModManager" Name="InstallLocation" Type="string" Value="[APPFOLDER]" />
        <RemoveFolder Id="RemoveApplicationFolder" On="uninstall" />
      </Component>
    </Directory></Directory></StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder"><Directory Id="ApplicationProgramsFolder" Name="DLSSG Mod Manager"><Component Id="MenuFolder" Guid="993B83B4-7ED0-4ACB-A033-82606F27988D"><RemoveFolder Id="RemoveMenuFolder" On="uninstall"/><RegistryValue Root="HKCU" Key="Software\DLSSGModManager" Name="Menu" Type="integer" Value="1" KeyPath="yes"/></Component></Directory></StandardDirectory>
    <StandardDirectory Id="DesktopFolder" />
    <Feature Id="Complete" Title="DLSSG Mod Manager" Level="1"><ComponentRef Id="ApplicationFiles"/><ComponentRef Id="MenuFolder"/></Feature>
    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="APPFOLDER" />
    <WixVariable Id="WixUILicenseRtf" Value="$(var.RepoDir)/installer/License.rtf" />
  </Package>
</Wix>
